<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_RoutingDefinitions" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_applicantItem" structureRef="com.example.walkthrough.model.Applicant"/>
  <bpmn2:itemDefinition id="_scoreItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_routeItem" structureRef="String"/>
  <bpmn2:itemDefinition id="__Task_Score_ParameterInputXItem" structureRef="com.example.walkthrough.model.Applicant"/>
  <bpmn2:itemDefinition id="__Task_Score_ResultOutputXItem" structureRef="Integer"/>
  <bpmn2:interface id="Task_Score_ServiceInterface" name="com.example.walkthrough.service.ScoringService" implementationRef="com.example.walkthrough.service.ScoringService">
    <bpmn2:operation id="Task_Score_ServiceOperation" name="score" implementationRef="score"/>
  </bpmn2:interface>
  <bpmn2:process id="loan_routing" drools:packageName="com.example.walkthrough" drools:version="1.0" drools:adHoc="false" name="Langkah 2 - Service Task dan Gateway" isExecutable="true" processType="Public">
    <bpmn2:property id="applicant" itemSubjectRef="_applicantItem" name="applicant"/>
    <bpmn2:property id="score" itemSubjectRef="_scoreItem" name="score"/>
    <bpmn2:property id="route" itemSubjectRef="_routeItem" name="route"/>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Score"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Task_Score" targetRef="Gateway_Score"/>
    <bpmn2:sequenceFlow id="Flow_High" name="skor &gt;= 700" sourceRef="Gateway_Score" targetRef="Task_Auto">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return score >= 700;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Mid" name="500 - 699" sourceRef="Gateway_Score" targetRef="Task_Manual">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return score >= 500 && score < 700;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Low" name="skor &lt; 500" sourceRef="Gateway_Score" targetRef="Task_Reject">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return score < 500;]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Task_Auto" targetRef="Gateway_Join"/>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Task_Manual" targetRef="Gateway_Join"/>
    <bpmn2:sequenceFlow id="Flow_5" sourceRef="Task_Reject" targetRef="Gateway_Join"/>
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Gateway_Join" targetRef="End"/>
    <bpmn2:startEvent id="Start" name="Pengajuan masuk">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:serviceTask id="Task_Score" drools:serviceimplementation="Java" drools:serviceinterface="com.example.walkthrough.service.ScoringService" drools:serviceoperation="score" name="Hitung Skor" implementation="Java" operationRef="Task_Score_ServiceOperation">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="Task_Score_ParameterInputX" drools:dtype="com.example.walkthrough.model.Applicant" itemSubjectRef="__Task_Score_ParameterInputXItem" name="Parameter"/>
        <bpmn2:dataOutput id="Task_Score_ResultOutputX" drools:dtype="Integer" itemSubjectRef="__Task_Score_ResultOutputXItem" name="Result"/>
        <bpmn2:inputSet><bpmn2:dataInputRefs>Task_Score_ParameterInputX</bpmn2:dataInputRefs></bpmn2:inputSet>
        <bpmn2:outputSet><bpmn2:dataOutputRefs>Task_Score_ResultOutputX</bpmn2:dataOutputRefs></bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation><bpmn2:sourceRef>applicant</bpmn2:sourceRef><bpmn2:targetRef>Task_Score_ParameterInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation><bpmn2:sourceRef>Task_Score_ResultOutputX</bpmn2:sourceRef><bpmn2:targetRef>score</bpmn2:targetRef></bpmn2:dataOutputAssociation>
    </bpmn2:serviceTask>
    <bpmn2:exclusiveGateway id="Gateway_Score" name="Berapa skornya?" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_High</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Mid</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Low</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:scriptTask id="Task_Auto" name="Setujui Otomatis" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_High</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("route", "AUTO_APPROVED");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_Manual" name="Kirim ke Review Manual" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_Mid</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("route", "MANUAL_REVIEW");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_Reject" name="Tolak" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_Low</bpmn2:incoming>
      <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("route", "REJECTED");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="Gateway_Join" gatewayDirection="Converging">
      <bpmn2:incoming>Flow_3</bpmn2:incoming>
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:incoming>Flow_5</bpmn2:incoming>
      <bpmn2:outgoing>Flow_6</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End" name="Selesai">
      <bpmn2:incoming>Flow_6</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="_Diagram">
    <bpmndi:BPMNPlane id="_Plane" bpmnElement="loan_routing">
      <bpmndi:BPMNShape id="shape_Start" bpmnElement="Start"><dc:Bounds height="36" width="36" x="87" y="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Score" bpmnElement="Task_Score"><dc:Bounds height="64" width="130" x="230" y="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Gateway_Score" bpmnElement="Gateway_Score"><dc:Bounds height="50" width="50" x="460" y="57"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Auto" bpmnElement="Task_Auto"><dc:Bounds height="64" width="130" x="610" y="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Manual" bpmnElement="Task_Manual"><dc:Bounds height="64" width="130" x="610" y="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Reject" bpmnElement="Task_Reject"><dc:Bounds height="64" width="130" x="610" y="310"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Gateway_Join" bpmnElement="Gateway_Join"><dc:Bounds height="50" width="50" x="840" y="57"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_End" bpmnElement="End"><dc:Bounds height="36" width="36" x="1037" y="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="123" y="82"/><di:waypoint x="230" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_2" bpmnElement="Flow_2"><di:waypoint x="360" y="82"/><di:waypoint x="460" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_High" bpmnElement="Flow_High"><di:waypoint x="510" y="82"/><di:waypoint x="610" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_Mid" bpmnElement="Flow_Mid"><di:waypoint x="485" y="107"/><di:waypoint x="485" y="212"/><di:waypoint x="610" y="212"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_Low" bpmnElement="Flow_Low"><di:waypoint x="485" y="107"/><di:waypoint x="485" y="342"/><di:waypoint x="610" y="342"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_3" bpmnElement="Flow_3"><di:waypoint x="740" y="82"/><di:waypoint x="840" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_4" bpmnElement="Flow_4"><di:waypoint x="740" y="212"/><di:waypoint x="865" y="212"/><di:waypoint x="865" y="107"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_5" bpmnElement="Flow_5"><di:waypoint x="740" y="342"/><di:waypoint x="865" y="342"/><di:waypoint x="865" y="107"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_6" bpmnElement="Flow_6"><di:waypoint x="890" y="82"/><di:waypoint x="1037" y="82"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
