<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_ApprovalDefinitions" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_applicantItem" structureRef="com.example.walkthrough.model.Applicant"/>
  <bpmn2:itemDefinition id="_approvedItem" structureRef="Boolean"/>
  <bpmn2:itemDefinition id="_noteItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_statusItem" structureRef="String"/>
  <bpmn2:itemDefinition id="__Task_Review_TaskNameInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__Task_Review_GroupIdInputXItem" structureRef="Object"/>
  <bpmn2:itemDefinition id="__Task_Review_applicantInputXItem" structureRef="com.example.walkthrough.model.Applicant"/>
  <bpmn2:itemDefinition id="__Task_Review_approvedOutputXItem" structureRef="Boolean"/>
  <bpmn2:itemDefinition id="__Task_Review_noteOutputXItem" structureRef="String"/>
  <bpmn2:process id="loan_approval" drools:packageName="com.example.walkthrough" drools:version="1.0" drools:adHoc="false" name="Langkah 3 - User Task" isExecutable="true" processType="Public">
    <bpmn2:property id="applicant" itemSubjectRef="_applicantItem" name="applicant"/>
    <bpmn2:property id="approved" itemSubjectRef="_approvedItem" name="approved"/>
    <bpmn2:property id="note" itemSubjectRef="_noteItem" name="note"/>
    <bpmn2:property id="status" itemSubjectRef="_statusItem" name="status"/>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Review"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Task_Review" targetRef="Gateway_Approved"/>
    <bpmn2:sequenceFlow id="Flow_Yes" name="disetujui" sourceRef="Gateway_Approved" targetRef="Task_Approved">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return Boolean.TRUE.equals(approved);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_No" name="ditolak" sourceRef="Gateway_Approved" targetRef="Task_Rejected">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return !Boolean.TRUE.equals(approved);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Task_Approved" targetRef="End_Approved"/>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Task_Rejected" targetRef="End_Rejected"/>
    <bpmn2:startEvent id="Start" name="Pengajuan masuk">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="Task_Review" name="Review Pinjaman">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="Task_Review_TaskNameInputX" drools:dtype="Object" itemSubjectRef="__Task_Review_TaskNameInputXItem" name="TaskName"/>
        <bpmn2:dataInput id="Task_Review_GroupIdInputX" drools:dtype="Object" itemSubjectRef="__Task_Review_GroupIdInputXItem" name="GroupId"/>
        <bpmn2:dataInput id="Task_Review_applicantInputX" drools:dtype="com.example.walkthrough.model.Applicant" itemSubjectRef="__Task_Review_applicantInputXItem" name="applicant"/>
        <bpmn2:dataOutput id="Task_Review_approvedOutputX" drools:dtype="Boolean" itemSubjectRef="__Task_Review_approvedOutputXItem" name="approved"/>
        <bpmn2:dataOutput id="Task_Review_noteOutputX" drools:dtype="String" itemSubjectRef="__Task_Review_noteOutputXItem" name="note"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>Task_Review_TaskNameInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Task_Review_GroupIdInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Task_Review_applicantInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>Task_Review_approvedOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_Review_noteOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>Task_Review_TaskNameInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[ReviewLoan]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[Task_Review_TaskNameInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>Task_Review_GroupIdInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[credit-officers]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[Task_Review_GroupIdInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation><bpmn2:sourceRef>applicant</bpmn2:sourceRef><bpmn2:targetRef>Task_Review_applicantInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation><bpmn2:sourceRef>Task_Review_approvedOutputX</bpmn2:sourceRef><bpmn2:targetRef>approved</bpmn2:targetRef></bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation><bpmn2:sourceRef>Task_Review_noteOutputX</bpmn2:sourceRef><bpmn2:targetRef>note</bpmn2:targetRef></bpmn2:dataOutputAssociation>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_Approved" name="Disetujui?" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Yes</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_No</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:scriptTask id="Task_Approved" name="Tandai Disetujui" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_Yes</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("status", "APPROVED");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="Task_Rejected" name="Tandai Ditolak" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_No</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("status", "REJECTED");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:endEvent id="End_Approved" name="Disetujui">
      <bpmn2:incoming>Flow_3</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="End_Rejected" name="Ditolak">
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="_Diagram">
    <bpmndi:BPMNPlane id="_Plane" bpmnElement="loan_approval">
      <bpmndi:BPMNShape id="shape_Start" bpmnElement="Start"><dc:Bounds height="36" width="36" x="87" y="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Review" bpmnElement="Task_Review"><dc:Bounds height="64" width="130" x="230" y="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Gateway_Approved" bpmnElement="Gateway_Approved"><dc:Bounds height="50" width="50" x="460" y="57"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Approved" bpmnElement="Task_Approved"><dc:Bounds height="64" width="130" x="610" y="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Rejected" bpmnElement="Task_Rejected"><dc:Bounds height="64" width="130" x="610" y="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_End_Approved" bpmnElement="End_Approved"><dc:Bounds height="36" width="36" x="847" y="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_End_Rejected" bpmnElement="End_Rejected"><dc:Bounds height="36" width="36" x="847" y="194"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="123" y="82"/><di:waypoint x="230" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_2" bpmnElement="Flow_2"><di:waypoint x="360" y="82"/><di:waypoint x="460" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_Yes" bpmnElement="Flow_Yes"><di:waypoint x="510" y="82"/><di:waypoint x="610" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_No" bpmnElement="Flow_No"><di:waypoint x="485" y="107"/><di:waypoint x="485" y="212"/><di:waypoint x="610" y="212"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_3" bpmnElement="Flow_3"><di:waypoint x="740" y="82"/><di:waypoint x="847" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_4" bpmnElement="Flow_4"><di:waypoint x="740" y="212"/><di:waypoint x="847" y="212"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
