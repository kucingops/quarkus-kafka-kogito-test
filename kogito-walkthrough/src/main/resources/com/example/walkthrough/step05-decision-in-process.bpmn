<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="_DecisionDefinitions" exporter="jBPM Process Modeler" exporterVersion="2.0" targetNamespace="http://www.omg.org/bpmn20">
  <bpmn2:itemDefinition id="_applicantItem" structureRef="com.example.walkthrough.model.Applicant"/>
  <bpmn2:itemDefinition id="_stringItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_numberItem" structureRef="java.math.BigDecimal"/>
  <bpmn2:itemDefinition id="__Task_Decide_namespaceInputXItem" structureRef="java.lang.String"/>
  <bpmn2:itemDefinition id="__Task_Decide_modelInputXItem" structureRef="java.lang.String"/>
  <bpmn2:itemDefinition id="__Task_Decide_ApplicantInputXItem" structureRef="com.example.walkthrough.model.Applicant"/>
  <bpmn2:itemDefinition id="__Task_Decide_AmountInputXItem" structureRef="Long"/>
  <bpmn2:itemDefinition id="__Task_Decide_EligibilityOutputXItem" structureRef="String"/>
  <bpmn2:itemDefinition id="__Task_Decide_RiskOutputXItem" structureRef="String"/>
  <bpmn2:itemDefinition id="__Task_Decide_MaxLoanOutputXItem" structureRef="java.math.BigDecimal"/>
  <bpmn2:itemDefinition id="__Call_Approval_applicantInputXItem" structureRef="com.example.walkthrough.model.Applicant"/>
  <bpmn2:itemDefinition id="__Call_Approval_statusOutputXItem" structureRef="String"/>
  <bpmn2:process id="loan_decision" drools:packageName="com.example.walkthrough" drools:version="1.0" drools:adHoc="false" name="Langkah 5 - DMN di dalam Proses" isExecutable="true" processType="Public">
    <bpmn2:property id="applicant" itemSubjectRef="_applicantItem" name="applicant"/>
    <bpmn2:property id="eligibility" itemSubjectRef="_stringItem" name="eligibility"/>
    <bpmn2:property id="riskCategory" itemSubjectRef="_stringItem" name="riskCategory"/>
    <bpmn2:property id="maxLoan" itemSubjectRef="_numberItem" name="maxLoan"/>
    <bpmn2:property id="status" itemSubjectRef="_stringItem" name="status"/>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Task_Decide"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Task_Decide" targetRef="Gateway_Eligibility"/>
    <bpmn2:sequenceFlow id="Flow_Approved" name="APPROVED" sourceRef="Gateway_Eligibility" targetRef="Task_Approved">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "APPROVED".equals(eligibility);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Review" name="REVIEW" sourceRef="Gateway_Eligibility" targetRef="Call_Approval">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "REVIEW".equals(eligibility);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Rejected" name="REJECTED" sourceRef="Gateway_Eligibility" targetRef="Task_Rejected">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return "REJECTED".equals(eligibility);]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Task_Approved" targetRef="Gateway_Join"/>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Call_Approval" targetRef="Gateway_Join"/>
    <bpmn2:sequenceFlow id="Flow_5" sourceRef="Task_Rejected" targetRef="Gateway_Join"/>
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Gateway_Join" targetRef="End"/>
    <bpmn2:startEvent id="Start" name="Pengajuan masuk">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:businessRuleTask id="Task_Decide" name="Cek Kelayakan (DMN)" implementation="http://www.jboss.org/drools/dmn">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="Task_Decide_namespaceInputX" drools:dtype="java.lang.String" itemSubjectRef="__Task_Decide_namespaceInputXItem" name="namespace"/>
        <bpmn2:dataInput id="Task_Decide_modelInputX" drools:dtype="java.lang.String" itemSubjectRef="__Task_Decide_modelInputXItem" name="model"/>
        <bpmn2:dataInput id="Task_Decide_ApplicantInputX" drools:dtype="com.example.walkthrough.model.Applicant" itemSubjectRef="__Task_Decide_ApplicantInputXItem" name="Applicant"/>
        <bpmn2:dataInput id="Task_Decide_AmountInputX" drools:dtype="Long" itemSubjectRef="__Task_Decide_AmountInputXItem" name="Requested Amount"/>
        <bpmn2:dataOutput id="Task_Decide_EligibilityOutputX" drools:dtype="String" itemSubjectRef="__Task_Decide_EligibilityOutputXItem" name="Eligibility"/>
        <bpmn2:dataOutput id="Task_Decide_RiskOutputX" drools:dtype="String" itemSubjectRef="__Task_Decide_RiskOutputXItem" name="Risk Category"/>
        <bpmn2:dataOutput id="Task_Decide_MaxLoanOutputX" drools:dtype="java.math.BigDecimal" itemSubjectRef="__Task_Decide_MaxLoanOutputXItem" name="Max Loan"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>Task_Decide_namespaceInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Task_Decide_modelInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Task_Decide_ApplicantInputX</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>Task_Decide_AmountInputX</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>Task_Decide_EligibilityOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_Decide_RiskOutputX</bpmn2:dataOutputRefs>
          <bpmn2:dataOutputRefs>Task_Decide_MaxLoanOutputX</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>Task_Decide_namespaceInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[https://example.com/walkthrough/dmn]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[Task_Decide_namespaceInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>Task_Decide_modelInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[LoanEligibility]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[Task_Decide_modelInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation><bpmn2:sourceRef>applicant</bpmn2:sourceRef><bpmn2:targetRef>Task_Decide_ApplicantInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:targetRef>Task_Decide_AmountInputX</bpmn2:targetRef>
        <bpmn2:assignment>
          <bpmn2:from xsi:type="bpmn2:tFormalExpression"><![CDATA[#{applicant.requestedAmount}]]></bpmn2:from>
          <bpmn2:to xsi:type="bpmn2:tFormalExpression"><![CDATA[Task_Decide_AmountInputX]]></bpmn2:to>
        </bpmn2:assignment>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation><bpmn2:sourceRef>Task_Decide_EligibilityOutputX</bpmn2:sourceRef><bpmn2:targetRef>eligibility</bpmn2:targetRef></bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation><bpmn2:sourceRef>Task_Decide_RiskOutputX</bpmn2:sourceRef><bpmn2:targetRef>riskCategory</bpmn2:targetRef></bpmn2:dataOutputAssociation>
      <bpmn2:dataOutputAssociation><bpmn2:sourceRef>Task_Decide_MaxLoanOutputX</bpmn2:sourceRef><bpmn2:targetRef>maxLoan</bpmn2:targetRef></bpmn2:dataOutputAssociation>
    </bpmn2:businessRuleTask>
    <bpmn2:exclusiveGateway id="Gateway_Eligibility" name="Hasil DMN?" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Approved</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Review</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Rejected</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:scriptTask id="Task_Approved" name="Setujui" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_Approved</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("status", "APPROVED");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:callActivity id="Call_Approval" drools:independent="false" drools:waitForCompletion="true" name="Review Manual (Langkah 3)" calledElement="loan_approval">
      <bpmn2:incoming>Flow_Review</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="Call_Approval_applicantInputX" drools:dtype="com.example.walkthrough.model.Applicant" itemSubjectRef="__Call_Approval_applicantInputXItem" name="applicant"/>
        <bpmn2:dataOutput id="Call_Approval_statusOutputX" drools:dtype="String" itemSubjectRef="__Call_Approval_statusOutputXItem" name="status"/>
        <bpmn2:inputSet><bpmn2:dataInputRefs>Call_Approval_applicantInputX</bpmn2:dataInputRefs></bpmn2:inputSet>
        <bpmn2:outputSet><bpmn2:dataOutputRefs>Call_Approval_statusOutputX</bpmn2:dataOutputRefs></bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation><bpmn2:sourceRef>applicant</bpmn2:sourceRef><bpmn2:targetRef>Call_Approval_applicantInputX</bpmn2:targetRef></bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation><bpmn2:sourceRef>Call_Approval_statusOutputX</bpmn2:sourceRef><bpmn2:targetRef>status</bpmn2:targetRef></bpmn2:dataOutputAssociation>
    </bpmn2:callActivity>
    <bpmn2:scriptTask id="Task_Rejected" name="Tolak" scriptFormat="http://www.java.com/java">
      <bpmn2:incoming>Flow_Rejected</bpmn2:incoming>
      <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("status", "REJECTED");]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="Gateway_Join" gatewayDirection="Converging">
      <bpmn2:incoming>Flow_3</bpmn2:incoming>
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:incoming>Flow_5</bpmn2:incoming>
      <bpmn2:outgoing>Flow_6</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End" name="Selesai">
      <bpmn2:incoming>Flow_6</bpmn2:incoming>
    </bpmn2:endEvent>
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="_Diagram">
    <bpmndi:BPMNPlane id="_Plane" bpmnElement="loan_decision">
      <bpmndi:BPMNShape id="shape_Start" bpmnElement="Start"><dc:Bounds height="36" width="36" x="87" y="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Decide" bpmnElement="Task_Decide"><dc:Bounds height="64" width="130" x="230" y="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Gateway_Eligibility" bpmnElement="Gateway_Eligibility"><dc:Bounds height="50" width="50" x="460" y="57"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Approved" bpmnElement="Task_Approved"><dc:Bounds height="64" width="130" x="610" y="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Call_Approval" bpmnElement="Call_Approval"><dc:Bounds height="64" width="130" x="610" y="180"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Task_Rejected" bpmnElement="Task_Rejected"><dc:Bounds height="64" width="130" x="610" y="310"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_Gateway_Join" bpmnElement="Gateway_Join"><dc:Bounds height="50" width="50" x="840" y="57"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_End" bpmnElement="End"><dc:Bounds height="36" width="36" x="1037" y="64"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_Flow_1" bpmnElement="Flow_1"><di:waypoint x="123" y="82"/><di:waypoint x="230" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_2" bpmnElement="Flow_2"><di:waypoint x="360" y="82"/><di:waypoint x="460" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_Approved" bpmnElement="Flow_Approved"><di:waypoint x="510" y="82"/><di:waypoint x="610" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_Review" bpmnElement="Flow_Review"><di:waypoint x="485" y="107"/><di:waypoint x="485" y="212"/><di:waypoint x="610" y="212"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_Rejected" bpmnElement="Flow_Rejected"><di:waypoint x="485" y="107"/><di:waypoint x="485" y="342"/><di:waypoint x="610" y="342"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_3" bpmnElement="Flow_3"><di:waypoint x="740" y="82"/><di:waypoint x="840" y="82"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_4" bpmnElement="Flow_4"><di:waypoint x="740" y="212"/><di:waypoint x="865" y="212"/><di:waypoint x="865" y="107"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_5" bpmnElement="Flow_5"><di:waypoint x="740" y="342"/><di:waypoint x="865" y="342"/><di:waypoint x="865" y="107"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_Flow_6" bpmnElement="Flow_6"><di:waypoint x="890" y="82"/><di:waypoint x="1037" y="82"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
