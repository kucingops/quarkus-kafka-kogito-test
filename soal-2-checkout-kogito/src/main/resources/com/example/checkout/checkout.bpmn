  <bpmn2:process id="checkout" drools:packageName="com.example.checkout" drools:version="1.0" drools:adHoc="false" name="Marketplace Checkout" isExecutable="true" processType="Public">
    <bpmn2:property id="checkout" itemSubjectRef="_checkoutItem" name="checkout"/>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_Checkout" targetRef="Task_ValidateCart"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Task_ValidateCart" targetRef="Gateway_CartValid"/>
    <bpmn2:sequenceFlow id="Flow_CartValid_Yes" name="Ya" sourceRef="Gateway_CartValid" targetRef="Task_CheckDuplicate">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Ya]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return checkout.isCartValid();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_CartValid_No" name="Tidak" sourceRef="Gateway_CartValid" targetRef="EndEvent_InvalidCart">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Tidak]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return !checkout.isCartValid();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_9" sourceRef="Task_CheckDuplicate" targetRef="Gateway_NewRequest"/>
    <bpmn2:sequenceFlow id="Flow_NewRequest_Yes" name="Ya" sourceRef="Gateway_NewRequest" targetRef="Task_ReserveStock">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Ya]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return !checkout.isDuplicateRequest();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_NewRequest_No" name="Tidak" sourceRef="Gateway_NewRequest" targetRef="EndEvent_DuplicateRequest">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Tidak]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return checkout.isDuplicateRequest();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Task_ReserveStock" targetRef="Gateway_StockAvailable"/>
    <bpmn2:sequenceFlow id="Flow_Stock_Yes" name="Ya" sourceRef="Gateway_StockAvailable" targetRef="Task_CalculateTotal">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Ya]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return checkout.isStockReserved();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Stock_No" name="Tidak" sourceRef="Gateway_StockAvailable" targetRef="EndEvent_OutOfStock">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Tidak]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return !checkout.isStockReserved();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Task_CalculateTotal" targetRef="Task_ProcessPayment"/>
    <bpmn2:sequenceFlow id="Flow_5" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentSuccess"/>
    <bpmn2:sequenceFlow id="Flow_Payment_Yes" name="Ya" sourceRef="Gateway_PaymentSuccess" targetRef="Task_CreateOrder">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Ya]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return checkout.isPaymentSuccess();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Payment_No" name="Tidak" sourceRef="Gateway_PaymentSuccess" targetRef="Task_ReleaseStock">
      <bpmn2:extensionElements><drools:metaData name="elementname"><drools:metaValue><![CDATA[Tidak]]></drools:metaValue></drools:metaData></bpmn2:extensionElements>
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java"><![CDATA[return !checkout.isPaymentSuccess();]]></bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Task_ReleaseStock" targetRef="EndEvent_PaymentFailed"/>
    <bpmn2:sequenceFlow id="Flow_7" sourceRef="Task_CreateOrder" targetRef="Task_SendNotification"/>
    <bpmn2:sequenceFlow id="Flow_8" sourceRef="Task_SendNotification" targetRef="EndEvent_Completed"/>
    <bpmn2:sequenceFlow id="Flow_OrderFailed" sourceRef="Boundary_OrderFailed" targetRef="Task_RefundPayment"/>
    <bpmn2:sequenceFlow id="Flow_10" sourceRef="Task_RefundPayment" targetRef="Task_ReleaseStockOrderFailed"/>
    <bpmn2:sequenceFlow id="Flow_11" sourceRef="Task_ReleaseStockOrderFailed" targetRef="EndEvent_OrderFailed"/>
